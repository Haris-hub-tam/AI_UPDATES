# Copy to .env and fill in what you want. Everything is optional.

# --- AI summaries (pick one; order Anthropic, Groq, Ollama, or set SUMMARY_PROVIDER) ---
# Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
# Model for summaries. Default: claude-haiku-5-5 (Anthropic's current fast, low-cost model)
ANTHROPIC_MODEL=claude-haiku-5-5

# Or Groq: fast hosted models, OpenAI-compatible API (https://console.groq.com/keys)
GROQ_API_KEY=
# Default: openai/gpt-oss-120b (Groq production model with strict JSON output)
GROQ_MODEL=openai/gpt-oss-120b

# Or a local model through Ollama
OLLAMA_MODEL=
OLLAMA_URL=http://localhost:11434
# SUMMARY_PROVIDER=groq

# --- Benchmarks: free key from https://artificialanalysis.ai/ (Insights Platform -> API) ---
AA_API_KEY=

# --- Limits per refresh ---
FULLTEXT_LIMIT=60
SUMMARY_LIMIT=30

# --- Advanced ---
# PORTAL_DB=/path/to/portal.db
# FEEDS_FILE=/path/to/feeds.toml
# WEEKLY_DIR=/path/to/weekly
# USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) ai-portal/1.0 (personal feed reader)
